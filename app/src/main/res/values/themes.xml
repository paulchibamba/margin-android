<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Margin" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
    </style>

    <style name="Theme.Margin.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_mark</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Margin</item>
    </style>
</resources>
